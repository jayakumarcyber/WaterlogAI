# CivicPulse Monsoon - Frontend Environment Configuration
# When deployed on Vercel with multiple services, leave NEXT_PUBLIC_API_BASE_URL blank
# to use same-origin routing (/api/v1/...) via vercel.json rewrites and service bindings.
NEXT_PUBLIC_API_BASE_URL=""
# In local development standalone mode (without vercel dev), specify:
# NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"

NEXT_PUBLIC_MAP_DEFAULT_LAT=13.0827
NEXT_PUBLIC_MAP_DEFAULT_LNG=80.2707
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
